{
  "name": "radio-tower",
  "version": "0.1.0",
  "private": true,
  "description": "A radio station where everyone hears the same second — on a Raspberry Pi, or as a static website where every browser is the station.",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "scan": "node scripts/scan.js",
    "test": "node --test \"tests/*.test.js\"",
    "healthcheck": "node scripts/healthcheck.js",
    "selftest": "bash scripts/build-test.sh",
    "collections": "node scripts/collections.mjs",
    "site:sync": "node scripts/site-sync.mjs",
    "cloud:check": "node scripts/cloud-library.mjs check",
    "site": "node scripts/site-serve.mjs",
    "site:texts": "node scripts/site-texts.mjs",
    "site:collections": "node scripts/site-collections.mjs",
    "site:build": "node scripts/site-build.mjs",
    "site:smoke": "node scripts/site-smoke.mjs",
    "preview": "node scripts/site-preview.mjs",
    "preview:smoke": "node scripts/preview-smoke.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "music-metadata": "^11.2.1"
  },
  "devDependencies": {
    "axe-core": "4.13.0",
    "playwright": "1.56.0"
  }
}
