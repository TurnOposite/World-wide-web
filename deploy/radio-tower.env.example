# Copy to /etc/radio-tower.env and edit.
# systemd reads this file; every value is optional and has a sane default.

# --- network -----------------------------------------------------------------
PORT=8080
HOST=0.0.0.0

# --- library -----------------------------------------------------------------
# Where your MP3s live. A mounted USB drive is typical on a Pi.
MUSIC_DIR=/mnt/music
# Scan cache. Must be writable by the service user (see ReadWritePaths in the unit).
CACHE_FILE=/opt/radio-tower/.cache/library.json
# Re-scan for newly added files every N minutes. 0 disables.
AUTO_RESCAN_MINUTES=30

# --- the station -------------------------------------------------------------
STATION_NAME=Radio Tower
STATION_TAGLINE=One signal. Everyone on the same second.

# The instant the station "started". The entire schedule is derived from this,
# so changing it re-deals the programme. Set it once, before you go public,
# and then leave it alone.
STATION_EPOCH=2026-01-01T00:00:00Z

# Silence between tracks, in seconds.
GAP_SECONDS=0

# How many upcoming tracks the player is told about.
LOOKAHEAD=5

# --- write access --------------------------------------------------------------
# Shared secret required for every endpoint that can change what's happening on
# the station: POST /api/queue/reorder, POST /api/queue/clear, and
# POST /api/rescan (roadmap #6 — an unauthenticated on-demand library scan is a
# standing invitation to force slow USB reads on a public URL). Unset disables
# all three outright (503) rather than leaving them open — this station is
# designed to sit on a public tunnel, so "off by default" is the only safe
# posture for a write endpoint out there. Pass it back as an
# `x-station-key: <value>` header (or a `?key=` query param).
# Generate one with: node -e "console.log(crypto.randomUUID())"
#STATION_KEY=

# Per-address request budget on /api (server/lib/ratelimit.js): a burst of
# RATE_BURST requests, refilled at RATE_PER_SECOND. Aimed at floods only — a
# classroom behind one address stays well under it. Requests from this machine
# itself never count. RATE_BURST=0 turns it off.
#RATE_BURST=300
#RATE_PER_SECOND=5
