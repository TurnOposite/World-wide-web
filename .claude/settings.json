{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "radio-tower": {
      "source": {
        "source": "directory",
        "path": "."
      }
    }
  },
  "enabledPlugins": {
    "radio-tower-ops@radio-tower": true
  },
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(npm install)",
      "Bash(npm install:*)",
      "Bash(node:*)",
      "Bash(bash scripts/build-test.sh)",
      "Bash(bash scripts/build-test.sh:*)",
      "Bash(curl -s localhost:*)",
      "Bash(curl -fsS http://127.0.0.1:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./music/**)",
      "Write(./music/**)",
      "Edit(./music/**)",
      "Bash(rm -rf:*)"
    ]
  },
  "env": {
    "STATION_NAME": "Radio Tower"
  }
}
